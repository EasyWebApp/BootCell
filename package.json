{
    "name": "boot-cell",
    "version": "3.0.0-alpha.1",
    "license": "LGPL-3.0",
    "author": "shiy2008@gmail.com",
    "description": "Web Components UI library based on WebCell v3, BootStrap v6, BootStrap Icon v1 & FontAwesome v7",
    "keywords": [
        "web",
        "component",
        "ui",
        "webcell",
        "bootstrap"
    ],
    "homepage": "https://bootstrap.web-cell.dev/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/EasyWebApp/BootCell.git"
    },
    "bugs": {
        "url": "https://github.com/EasyWebApp/BootCell/issues"
    },
    "source": "source/index.ts",
    "types": "dist/index.d.ts",
    "main": "dist/index.js",
    "module": "dist/index.esm.js",
    "exports": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.esm.js",
        "require": "./dist/index.js"
    },
    "dependencies": {
        "@swc/helpers": "^0.5.23",
        "browser-fs-access": "^0.38.0",
        "classnames": "^2.5.1",
        "dom-renderer": "^2.7.0",
        "iterable-observer": "^1.1.1",
        "mime": "^4.1.2",
        "prismjs": "^1.30.0",
        "regenerator-runtime": "^0.14.1",
        "web-cell": "^3.2.2",
        "web-utility": "^4.8.1"
    },
    "peerDependencies": {
        "@fortawesome/fontawesome-free": "^7",
        "bootstrap": ">=6.0.0-alpha.1 <7",
        "bootstrap-icons": "^1",
        "dialog-polyfill": "^0.5",
        "iterable-observer": "^1",
        "mobx": ">=6.11",
        "share-api-polyfill": "^1"
    },
    "devDependencies": {
        "@parcel/config-default": "~2.16.4",
        "@parcel/packager-ts": "~2.16.4",
        "@parcel/transformer-less": "~2.16.4",
        "@parcel/transformer-typescript-tsc": "~2.16.4",
        "@parcel/transformer-typescript-types": "~2.16.4",
        "@swc-node/register": "^1.12.1",
        "@swc/core": "^1.16.20",
        "@types/node": "^26.6.5",
        "@types/prismjs": "^1.26.6",
        "@types/turndown": "^5.0.6",
        "buffer": "^6.0.3",
        "cross-env": "^10.1.0",
        "expect": "^30.5.2",
        "husky": "^9.1.7",
        "jest-mock": "^30.5.2",
        "jsdom": "^30.1.3",
        "less": "^4.9.1",
        "lint-staged": "^17.6.0",
        "mobx": "^7.1.3",
        "open-cli": "^9.0.0",
        "parcel": "~2.16.4",
        "prettier": "^3.9.10",
        "process": "^0.11.10",
        "typedoc": "^0.28.20",
        "typedoc-plugin-mdn-links": "^5.1.1",
        "typescript": "~5.9.3"
    },
    "scripts": {
        "prepare": "husky",
        "test": "lint-staged  &&  npm run test:types  &&  npm run test:unit",
        "test:types": "tsc --noEmit  &&  tsc --noEmit -p test/tsconfig.json",
        "test:unit": "node --import ./test/register.mjs --test \"test/**/*.spec.tsx\"",
        "start": "cd test/  &&  rm -rf dist/ ../.parcel-cache  &&  parcel index.html --open",
        "pack-dist": "rm -rf dist/  &&  parcel build source/index.ts",
        "pack-docs": "rm -rf docs/  &&  typedoc source/",
        "build": "npm run pack-dist  &&  npm run pack-docs",
        "help": "npm run pack-docs  &&  open-cli docs/index.html",
        "prepublishOnly": "npm test  &&  npm run build"
    },
    "lint-staged": {
        "*.{html,md,less,json,yml,js,mjs,ts,tsx}": "prettier --write"
    },
    "browserslist": "> 0.5%, last 2 versions, not dead",
    "targets": {
        "main": {
            "optimize": true
        }
    }
}
