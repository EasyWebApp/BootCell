{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug unit tests",
            "type": "node",
            "request": "launch",
            "runtimeArgs": [
                "--import",
                "./test/register.mjs",
                "--test",
                "--test-concurrency=1",
                "test/**/*.spec.tsx"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen"
        }
    ]
}
